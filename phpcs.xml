<?xml version="1.0"?>
<ruleset name="kelpgate-php">
  <description>PSR-12 for the Kelpgate PHP client.</description>
  <file>src</file>
  <file>tests</file>
  <arg name="colors"/>
  <arg value="sp"/>
  <rule ref="PSR12"/>
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="140"/>
      <property name="absoluteLineLimit" value="0"/>
    </properties>
  </rule>
</ruleset>
