{
  "name": "kelpgate/kelpgate-php",
  "description": "Kelpgate Client for PHP: scan uploaded files and URLs for malware with the Kelpgate API.",
  "type": "library",
  "keywords": ["kelpgate", "malware", "antivirus", "virus-scan", "clamav", "yara", "upload", "laravel", "wordpress"],
  "homepage": "https://kelpgate.cloud",
  "license": "MIT",
  "authors": [
    { "name": "JustBots Labs", "homepage": "https://kelpgate.cloud" }
  ],
  "support": {
    "issues": "https://github.com/KelpGate/kelpgate-php/issues",
    "source": "https://github.com/KelpGate/kelpgate-php",
    "email": "support@kelpgate.cloud"
  },
  "require": {
    "php": ">=7.4",
    "ext-json": "*"
  },
  "suggest": {
    "ext-curl": "Needed by the default transport. Without it, pass your own Kelpgate\\Http\\Transport."
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10 || ^4.0"
  },
  "autoload": {
    "psr-4": { "Kelpgate\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Kelpgate\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "lint": "phpcs",
    "check": ["@lint", "@analyse", "@test"]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable"
}
